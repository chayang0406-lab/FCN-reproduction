# =============================================================================
# Model configs for the FCNv2 improvement experiments (project-local).
# The original repo config (code/FCN/config/) is left untouched so the baseline
# stays pristine.
# =============================================================================
# IMPORTANT - why this file is pure ASCII:
#   fuxictr 2.0.1 load_config() does `open(config, 'r')` WITHOUT an explicit
#   encoding, so it decodes with the platform default locale encoding.
#   On a non-UTF-8 locale (Windows GBK, or Linux with LANG=C) any non-ASCII
#   byte here raises UnicodeDecodeError before training even starts.
#   All Chinese explanations therefore live in docs/ and in the Python
#   docstrings; the yaml stays ASCII so it loads on any machine.
#
# Naming: FCNv2_C_<purpose>_<switch>. C = Criteo.
#   C_base   : original behaviour (tri_bce_mode=hard, lca_compress_ratio=0.5)
#              -> numerically identical to the upstream src/FCNv2.py
#   C_soft*  : Tri-BCE soft weighting (auxiliary contribution)
#   C_r*     : LCA compression-ratio sweep (main contribution)
#   C_abl*   : ablations (w/o Tri-BCE, w/o E2L, w/o L2E)
#
# Every experiment shares the author's hyperparameters (taken from
# checkpoints/Criteo_x4_10_h5/FCNv2_Criteo_016_cde6d2ff.log, the log whose
# config matches current HEAD):
#   batch_size 8192, lr 1e-3, embedding_regularizer 1e-5, net_dropout 0.1,
#   exp_num_layers 4, lin_num_layers 1, num_heads 1, batch_norm False,
#   embedding_dim 16, seed 2025, early_stop_patience 2
# so an A/B pair differs in exactly one place.
# =============================================================================

Base:
    model_root: './checkpoints/'
    num_workers: 8
    verbose: 1
    early_stop_patience: 2
    pickle_feature_encoder: True
    save_best_only: True
    eval_steps: null
    debug_mode: False
    group_id: null
    use_features: null
    feature_specs: null
    feature_config: null

# -----------------------------------------------------------------------------
# E0 baseline: original behaviour.
# Both switches take their default values (hard / 0.5), so this is numerically
# identical to upstream src/FCNv2.py. Bit-exactness is asserted with torch.equal
# (not allclose) in code/src/tests/test_bit_exact.py.
# -----------------------------------------------------------------------------
FCNv2_C_base:
    model: FCNv2
    dataset_id: Criteo_x4_10_h5
    data_format: h5
    data_root: './data/'
    loss: 'binary_crossentropy'
    metrics: ['logloss', 'AUC']
    task: binary_classification
    optimizer: adam
    learning_rate: 1.e-3
    embedding_regularizer: 1.e-5
    net_regularizer: 0
    batch_size: 8192
    embedding_dim: 16
    exp_num_layers: 4
    lin_num_layers: 1
    net_dropout: 0.1
    batch_norm: False
    layer_norm: False
    num_heads: 1
    epochs: 100
    shuffle: True
    seed: 2025
    monitor: {'AUC': 1, 'logloss': 0}
    monitor_mode: 'max'
    # switches: defaults == original behaviour
    tri_bce_mode: 'hard'
    lca_compress_ratio: 0.5

# =============================================================================
# Tri-BCE soft weighting (auxiliary contribution)
# =============================================================================
# Primary soft variant: smoothmax. It has NO constant bias term, unlike
# softplus (see the improvement plan document under docs/ section 3.1). beta=100 is chosen so that
# beta*delta lands in 1e-2..1e-1 given the typical delta = L_aux - L_main
# magnitude of 1e-4..1e-3 on Criteo.
FCNv2_C_soft_smoothmax:
    model: FCNv2
    dataset_id: Criteo_x4_10_h5
    data_format: h5
    data_root: './data/'
    loss: 'binary_crossentropy'
    metrics: ['logloss', 'AUC']
    task: binary_classification
    optimizer: adam
    learning_rate: 1.e-3
    embedding_regularizer: 1.e-5
    net_regularizer: 0
    batch_size: 8192
    embedding_dim: 16
    exp_num_layers: 4
    lin_num_layers: 1
    net_dropout: 0.1
    batch_norm: False
    layer_norm: False
    num_heads: 1
    epochs: 100
    shuffle: True
    seed: 2025
    monitor: {'AUC': 1, 'logloss': 0}
    monitor_mode: 'max'
    tri_bce_mode: 'smoothmax'
    tri_bce_alpha: 1.0
    tri_bce_beta: 100.0
    lca_compress_ratio: 0.5

# softplus variant. beta must be large to suppress the log(2)/beta constant
# bias; beta=1e4 gives a residual bias of 6.9e-5, i.e. below the delta scale.
FCNv2_C_soft_softplus:
    model: FCNv2
    dataset_id: Criteo_x4_10_h5
    data_format: h5
    data_root: './data/'
    loss: 'binary_crossentropy'
    metrics: ['logloss', 'AUC']
    task: binary_classification
    optimizer: adam
    learning_rate: 1.e-3
    embedding_regularizer: 1.e-5
    net_regularizer: 0
    batch_size: 8192
    embedding_dim: 16
    exp_num_layers: 4
    lin_num_layers: 1
    net_dropout: 0.1
    batch_norm: False
    layer_norm: False
    num_heads: 1
    epochs: 100
    shuffle: True
    seed: 2025
    monitor: {'AUC': 1, 'logloss': 0}
    monitor_mode: 'max'
    tri_bce_mode: 'softplus'
    tri_bce_alpha: 1.0
    tri_bce_beta: 10000.0
    lca_compress_ratio: 0.5

# Normalised (scale-invariant) soft weight, kept un-clamped on purpose so we can
# observe whether negative weights destabilise training.
FCNv2_C_soft_ratio:
    model: FCNv2
    dataset_id: Criteo_x4_10_h5
    data_format: h5
    data_root: './data/'
    loss: 'binary_crossentropy'
    metrics: ['logloss', 'AUC']
    task: binary_classification
    optimizer: adam
    learning_rate: 1.e-3
    embedding_regularizer: 1.e-5
    net_regularizer: 0
    batch_size: 8192
    embedding_dim: 16
    exp_num_layers: 4
    lin_num_layers: 1
    net_dropout: 0.1
    batch_norm: False
    layer_norm: False
    num_heads: 1
    epochs: 100
    shuffle: True
    seed: 2025
    monitor: {'AUC': 1, 'logloss': 0}
    monitor_mode: 'max'
    tri_bce_mode: 'ratio'
    tri_bce_alpha: 1.0
    tri_bce_clamp_nonneg: False
    lca_compress_ratio: 0.5

# smoothmax + annealing. lambda=0.3 gives decay 0.22 at epoch 5 and 0.05 at
# epoch 10: strong early, weak late.
FCNv2_C_soft_smoothmax_anneal:
    model: FCNv2
    dataset_id: Criteo_x4_10_h5
    data_format: h5
    data_root: './data/'
    loss: 'binary_crossentropy'
    metrics: ['logloss', 'AUC']
    task: binary_classification
    optimizer: adam
    learning_rate: 1.e-3
    embedding_regularizer: 1.e-5
    net_regularizer: 0
    batch_size: 8192
    embedding_dim: 16
    exp_num_layers: 4
    lin_num_layers: 1
    net_dropout: 0.1
    batch_norm: False
    layer_norm: False
    num_heads: 1
    epochs: 100
    shuffle: True
    seed: 2025
    monitor: {'AUC': 1, 'logloss': 0}
    monitor_mode: 'max'
    tri_bce_mode: 'smoothmax'
    tri_bce_alpha: 1.0
    tri_bce_beta: 100.0
    tri_bce_anneal_lambda: 0.3
    tri_bce_anneal_floor: 0.0
    lca_compress_ratio: 0.5

# =============================================================================
# LCA compression-ratio sweep (MAIN contribution): r in {1/4, 1/2, 3/4, 1}
#
# -----------------------------------------------------------------------------
# IMPORTANT: E4-B uses exp=4 / lin=5 (NINE layers per sub-network), NOT the
# E0 baseline's exp=4 / lin=1 (five layers). Reason: the paper's Table 5 reports
# FCNp as 4 ECN layers + 5 LCN layers = 9 layers (1.76M single sub-network).
# Comparing our 5-layer r=1/2 (980,305) against the paper's 1.76M would wrongly
# suggest "we only have half the parameters". E0/noise baselines keep exp=4/lin=1
# to match author log _016; E4-B uses exp=4/lin=5 to match the paper's Table 5.
# The *_9L configs below are the ones to use for E4-B.
# -----------------------------------------------------------------------------
#
# Only lca_compress_ratio changes inside each pair, so r is the single
# independent variable of the params-vs-AUC curve.
#
# Parameter counts, 9-layer (exp=4, lin=5) sub-network, D=624:
#   r=1/4 : single   885,145  -> two sub-networks 1,770,290
#   r=1/2 : single 1,764,049  -> two sub-networks 3,528,098  (matches paper FCNp 1.76M;
#           the two-sub-network total 3,528,098 also matches author log _020 exactly)
#   r=3/4 : single 2,642,953  -> two sub-networks 5,285,906
#   r=1   : single 3,510,625  -> two sub-networks 7,021,250  (matches paper FCNp-full 3.51M)
# Ratio r=1 : r=1/2 = 1.9901, NOT 2.0000, because r=1 takes the full-rank path
# WITHOUT gamma/beta (2*D fewer params per layer).
# (tools_paper_comparison.py computes and asserts all of the above.)
#
# REPRODUCIBILITY SCOPE - must be stated in the report:
#   r=1/2 and r=1 reproduce the paper's own family:
#       r=1/2 -> LCA structure  (w: D->D/2, gamma/beta, concat, 2d==D so no resize)
#       r=1   -> full-rank      (w: D->D, no gamma/beta, no concat)
#   r=1/4 and r=3/4 are NOT part of the paper's structural family. The paper's
#   concat trick only recovers the dimension when 2*d*r == d, i.e. r == 1/2
#   exactly. For those two settings this work adds a ZERO-PARAMETER width
#   adapter (tile-then-truncate when 2*d < D, zero-pad-then-group-sum when
#   2*d > D). It introduces no extra trainable parameters, so the
#   "params scale monotonically with r" claim still holds, but the extra
#   operator is our own extension and must be declared as such.
# =============================================================================

